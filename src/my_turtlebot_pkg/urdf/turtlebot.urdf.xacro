<?xml version="1.0"?>
<robot name="amr_n20" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       AMR N20 — Hardware-accurate URDF
       Package: my_turtlebot_pkg
       Base numbers come from measured hardware specs. Tower (tiers
       1-3) numbers are VISUAL ESTIMATES read off a photo using the
       lidar's known height as a scale reference — verify against
       the real robot and correct the properties below if off.
       Meshes referenced are the RECENTERED versions (geometric
       center = mesh origin, units = meters).
       ============================================================ -->

  <!-- ========== 1. XACRO PROPERTIES (edit here, not below) ========== -->

  <!-- Chassis (waffle plate) -->
  <xacro:property name="chassis_length"  value="0.14"/>
  <xacro:property name="chassis_width"   value="0.14"/>
  <xacro:property name="chassis_height"  value="0.009"/>
  <xacro:property name="chassis_mass"    value="0.5"/>

  <!-- Wheels (N20 + GA12-N20 rim + rubber tire) -->
  <xacro:property name="wheel_radius"      value="0.0215"/>
  <xacro:property name="wheel_thickness"   value="0.015"/>
  <xacro:property name="wheel_separation"  value="0.152"/>   <!-- center-to-center -->
  <xacro:property name="wheel_mass"        value="0.05"/>    <!-- ESTIMATE -->
  <xacro:property name="wheel_offset_x" value="0.03"/>  <!-- Newly added 1 ASSUMPTION: tune to balance -->

  <!-- Caster -->
  <xacro:property name="caster_radius"   value="0.0135"/>
  <xacro:property name="caster_mass"     value="0.09"/>      <!-- ESTIMATE -->
  <xacro:property name="caster_offset_x" value="-0.055"/>    <!-- ASSUMPTION: verify -->
  
  <!-- N20 Encoded Motor -->
  <xacro:property name="motor_mass"     value="0.02"/>  <!-- ESTIMATE -->
  <xacro:property name="motor_offset_x" value="-0.02"/> <!-- how far inboard (toward center) from wheel, ASSUMPTION -->
  
  <!-- Electronics tower — ESTIMATED FROM PHOTO, verify & correct -->
  <xacro:property name="tier1_standoff_h" value="0.035"/>  <!-- changed1 -->
  <xacro:property name="tier1_deck_size"  value="0.14"/>  <!-- changed1 -->
  <xacro:property name="tier1_deck_t"     value="0.009"/>  <!-- same plate stock as chassis -->

  <xacro:property name="tier3_standoff_h" value="0.035"/>  <!-- changed2 -->
  <xacro:property name="tier3_deck_size"  value="0.14"/>
  <xacro:property name="tier3_deck_t"     value="0.009"/>  <!-- changed1 -->

  <xacro:property name="standoff_radius"  value="0.002"/>
  <xacro:property name="deck_mass"        value="0.03"/>     <!-- ESTIMATE, per deck -->

  <!-- Lidar (RPLIDAR A1M8) -->
  <xacro:property name="lidar_radius"    value="0.049"/>
  <xacro:property name="lidar_height"    value="0.0577"/>  <!-- corrected: true up-axis extent post-rotation -->
  <xacro:property name="lidar_mass"      value="0.19"/>

  

  <xacro:property name="PI" value="3.14159265"/>

  <!-- ========== 2. MATERIALS (for RViz, meshes have no color) ========== -->

  <material name="chassis_grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="caster_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="lidar_red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>
  <material name="deck_yellow">
    <color rgba="0.95 0.9 0.55 1.0"/>
  </material>
  <material name="deck_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="standoff_grey">
    <color rgba="0.55 0.55 0.55 1.0"/>
  </material>

  <!-- ========== 3. REUSABLE INERTIA MACROS ========== -->

  <xacro:macro name="box_inertia" params="mass x y z">
    <inertia
      ixx="${(1/12)*mass*(y*y+z*z)}" ixy="0.0" ixz="0.0"
      iyy="${(1/12)*mass*(x*x+z*z)}" iyz="0.0"
      izz="${(1/12)*mass*(x*x+y*y)}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="mass r h">
    <inertia
      ixx="${(1/12)*mass*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
      iyy="${(1/12)*mass*(3*r*r+h*h)}" iyz="0.0"
      izz="${(1/2)*mass*r*r}"/>
  </xacro:macro>

  <xacro:macro name="sphere_inertia" params="mass r">
    <inertia
      ixx="${(2/5)*mass*r*r}" ixy="0.0" ixz="0.0"
      iyy="${(2/5)*mass*r*r}" iyz="0.0"
      izz="${(2/5)*mass*r*r}"/>
  </xacro:macro>

  <!-- ============================================================
       4. BASE FOOTPRINT — massless reference frame at ground level
       ============================================================ -->

  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       5. BASE LINK — the waffle plate chassis
       ============================================================ -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://my_turtlebot_pkg/meshes/waffleplate.stl" scale="1 1 1"/>
      </geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </inertial>
  </link>

  <!-- ============================================================
       6. WHEELS
       ============================================================ -->

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <mesh filename="package://my_turtlebot_pkg/meshes/n20wheels.stl" scale="1 1 1"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia mass="${wheel_mass}" r="${wheel_radius}" h="${wheel_thickness}"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <!--<origin xyz="0 ${reflect * wheel_separation/2} 0" rpy="0 0 0"/>-->
      <origin xyz="${wheel_offset_x} ${reflect * wheel_separation/2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ============================================================
       7. N20MOTORS
       ============================================================ -->
  <xacro:macro name="motor" params="prefix reflect">
  <link name="${prefix}_motor_link">
    <visual>
      <origin xyz="0.0455 ${reflect * -0.018} 0" rpy="0 ${PI if reflect == -1 else 0} ${0 if reflect == -1 else PI}"/>
      <geometry>
        <mesh filename="package://my_turtlebot_pkg/meshes/n20motor_centered.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>
    <!-- Collision -->
    <collision>
      <origin xyz="0.0455 ${reflect * -0.018} 0"
              rpy="0 ${PI if reflect == -1 else 0} ${0 if reflect == -1 else PI}"/>
      <geometry>
        <mesh filename="package://my_turtlebot_pkg/meshes/n20motor_centered.stl"
            scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${motor_mass}"/>
      <xacro:cylinder_inertia mass="${motor_mass}" r="0.006" h="0.0405"/>
    </inertial>
  </link>

  <joint name="${prefix}_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="${prefix}_motor_link"/>
    <origin xyz="${motor_offset_x} ${reflect * wheel_separation/2} 0" rpy="0 0 0"/>
  </joint>
  </xacro:macro>

  <xacro:motor prefix="left"  reflect="1"/>
  <xacro:motor prefix="right" reflect="-1"/>

  <!-- ============================================================
       7. CASTER
       ============================================================ -->

  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0.009" rpy="0 ${PI} 0"/>  <!--changed3 -->
      <geometry>
        <mesh filename="package://my_turtlebot_pkg/meshes/casters.stl" scale="1 1 1"/>
      </geometry>
      <material name="caster_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <xacro:sphere_inertia mass="${caster_mass}" r="${caster_radius}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_offset_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>

  <!-- ============================================================
       8. ELECTRONICS TOWER — tier1 (electronics/power deck, yellow),
       tier3 (lidar mount deck, black), each held up by four visual
       standoff rods. Kept the name "tier3" for continuity even
       though tier2 was removed. Boxes/cylinders for collision —
       waffleplate mesh (scaled) for visual only.
       ============================================================ -->

  <xacro:macro name="standoff_rod" params="x y h dz">
    <visual>
      <origin xyz="${x} ${y} ${dz}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${standoff_radius}" length="${h}"/>
      </geometry>
      <material name="standoff_grey"/>
    </visual>
  </xacro:macro>

  <xacro:macro name="tower_tier" params="name parent_link standoff_h deck_size deck_t z_gap material_deck">
    <link name="${name}_link">
      <visual>
        <!-- reuse the same waffleplate mesh, scaled down to this tier's footprint -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://my_turtlebot_pkg/meshes/waffleplate.stl"
                scale="${deck_size/chassis_length} ${deck_size/chassis_length} 1"/>
        </geometry>
        <material name="${material_deck}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${deck_size} ${deck_size} ${deck_t}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${deck_mass}"/>
        <xacro:box_inertia mass="${deck_mass}" x="${deck_size}" y="${deck_size}" z="${deck_t}"/>
      </inertial>

      <xacro:standoff_rod x="${deck_size/2 - 0.025}"    y="${deck_size/2 - 0.025}"    h="${standoff_h}" dz="${-(deck_t/2 + standoff_h/2)}"/>
      <xacro:standoff_rod x="${-(deck_size/2 - 0.025)}" y="${deck_size/2 - 0.025}"    h="${standoff_h}" dz="${-(deck_t/2 + standoff_h/2)}"/>
      <xacro:standoff_rod x="${deck_size/2 - 0.025}"    y="${-(deck_size/2 - 0.025)}" h="${standoff_h}" dz="${-(deck_t/2 + standoff_h/2)}"/>
      <xacro:standoff_rod x="${-(deck_size/2 - 0.025)}" y="${-(deck_size/2 - 0.025)}" h="${standoff_h}" dz="${-(deck_t/2 + standoff_h/2)}"/>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 ${z_gap}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:tower_tier name="tier1" parent_link="base_link"
    standoff_h="${tier1_standoff_h}" deck_size="${tier1_deck_size}" deck_t="${tier1_deck_t}"
    z_gap="${chassis_height + tier1_standoff_h + tier1_deck_t/2}" material_deck="deck_yellow"/>

  <xacro:tower_tier name="tier3" parent_link="tier1_link"
    standoff_h="${tier3_standoff_h}" deck_size="${tier3_deck_size}" deck_t="${tier3_deck_t}"
    z_gap="${tier1_deck_t/2 + tier3_standoff_h + tier3_deck_t/2}" material_deck="deck_black"/>

  <!-- ============================================================
       9. LIDAR — now mounted on top of tier3 deck, not directly
       on the chassis
       ============================================================ -->

  <link name="lidar_link">
    <visual>
      <!-- mesh's real "up" axis is its own Y, not Z — rotate 90 deg about X
           to bring it in line with the world Z (up) axis -->
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <mesh filename="package://my_turtlebot_pkg/meshes/rplidar.STL" scale="1 1 1"/>
      </geometry>
      <material name="lidar_red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${lidar_mass}"/>
      <xacro:cylinder_inertia mass="${lidar_mass}" r="${lidar_radius}" h="${lidar_height}"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="tier3_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${tier3_deck_t/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>
<!-- ============================================================
     10. GAZEBO PLUGINS — DiffDrive + LiDAR sensor
     ============================================================ -->

<gazebo>
  <plugin filename="gz-sim-diff-drive-system"
          name="gz::sim::systems::DiffDrive">
    <left_joint>left_wheel_joint</left_joint>
    <right_joint>right_wheel_joint</right_joint>
    <wheel_separation>${wheel_separation}</wheel_separation>
    <wheel_radius>${wheel_radius}</wheel_radius>
    <odom_publish_frequency>30</odom_publish_frequency>
    <topic>cmd_vel</topic>
    <odom_topic>odom</odom_topic>
    <tf_topic>tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>base_footprint</child_frame_id>
  </plugin>

  <plugin filename="gz-sim-joint-state-publisher-system"
          name="gz::sim::systems::JointStatePublisher">
  </plugin>
</gazebo>

<gazebo reference="lidar_link">
  <sensor name="lidar_sensor" type="gpu_lidar">
    <pose>0 0 0 0 0 0</pose>
    <topic>scan</topic>
    <gz_frame_id>lidar_link</gz_frame_id>
    <update_rate>10</update_rate>
    <lidar>
      <scan>
        <horizontal>
          <samples>360</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.12</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
  </sensor>
</gazebo>
</robot>
